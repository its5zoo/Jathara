# ==============================================================================
# ISF Startup Jathara 2026 — Dandakaranya Summit
# Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Copy this file to .env.local for local development.
# - DO NOT commit .env.local or real credential values to Git.
# - Only variables prefixed with NEXT_PUBLIC_ are accessible in client browser code.
# - Server-only secrets MUST NEVER be prefixed with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CANONICAL SITE CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. FIREBASE CLIENT CONFIGURATION (Public — Safe for Browser)
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyPlaceholderClientApiKey12345
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK CONFIGURATION (Server-Side Only — PRIVATE)
# Obtain from: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Note: For private key, preserve quotes and \n newline escaping if storing in .env
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. SUPER ADMIN AUTHORIZATION (Server-Side Only — PRIVATE)
# Email address of the single authorized Super Admin account
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@isfjathara.org

# ------------------------------------------------------------------------------
# 5. CLOUDINARY MEDIA CONFIGURATION
# Obtain from: Cloudinary Dashboard -> Account Details
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-cloudinary-api-secret-here
# Optional: Signed upload preset with max_file_size enforcement configured in Cloudinary Console
CLOUDINARY_UPLOAD_PRESET=your-signed-upload-preset-name

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED RATE LIMITING (Optional — Serverless Anti-Spam via Upstash Redis)
# If unconfigured, the application falls back safely to in-memory sliding window
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token-here
